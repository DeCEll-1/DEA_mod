{
	"id":"DEA_BoundlessMissileProj",
	"specClass":"missile",
	"missileType":"MISSILE",
	"sprite":"graphics/missiles/DEA_BoundlessMissileProj.png",
	#"size":[66,66],
	#"center":[33,33],
	"size":[8,16],
	"center":[4,8],	
	"collisionRadius":8,
	"collisionClass":"MISSILE_NO_FF",
	"explosionColor":[230,230,230,255],  # purely visual, will get a white additively blended core on top of this color
	"explosionRadius":90, # purely visual
	#"alwaysAccelerate":true,
	"reduceDamageWhileFading":true,
	#"noCollisionWhileFading":true,
	"useHitGlowWhenDestroyed":true,
	"fizzleOnReachingWeaponRange":true,
	"dudProbabilityOnFlameout":0,
	"armingTime":3,
	"flameoutTime":4,
	"noEngineGlowTime":4,
	"fadeTime":4,
	"glowColor":[0,0,0,75],
	"glowRadius":75,
	"engineSpec":{"turnAcc":500,
				  "turnRate":75,
				  "acc":1200,
				  "dec":300},
	"engineSlots":[{"id":"ES1",
					"loc":[-10, 0],
				    #"style":"TORPEDO_ATROPOS",
				    "style":"CUSTOM",
					"styleSpec":{
						"mode":"QUAD_STRIP", # PARTICLES or QUAD_STRIP, determines which params are used
						"engineColor":[255,255,255,0],
						"glowSizeMult":2.0,
						"glowAlternateColor":[255,255,255,0],
						"contrailDuration":2,
						"contrailWidthMult":1,
						"contrailWidthAddedFractionAtEnd":2,  # can be negative. makes trail spread out/narrow at the end
						"contrailMinSeg":5, # min segment length, in pixels
						"contrailMaxSpeedMult":.0f,
						"contrailAngularVelocityMult":0.5f,
						"contrailSpawnDistMult":.5, # how far away from engine it starts
						"contrailColor":[155,100,70,0],
						"type":"GLOW" # GLOW or SMOKE; additive or regular blend mode
					},
				    "width":10.0,
				    "length":50.0,
				    "angle":180.0}]
}